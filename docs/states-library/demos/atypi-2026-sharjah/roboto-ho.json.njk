{%- macro color(rgb, alpha) -%}
{
                "instance": {
                  "R": "{{ rgb[0] }}",
                  "G": "{{ rgb[1] }}",
                  "B": "{{ rgb[2] }}"{% if alpha is defined %},
                  "alpha": "{{ alpha }}"{% endif %}
                },
                "colorTypeKey": "RGB"
              }
{%- endmacro %}
{%- macro pairs(items) -%}
              [
{%- for item in items %}
                ["{{ item[0] }}", "{{ item[1] }}"]{{ "," if not loop.last }}
{%- endfor %}
              ]
{%- endmacro %}
{%- macro axesOf(location) -%}
{%- set items = [] %}
{%- for axis, value in location %}{% set _ = items.push([axis, value]) %}{% endfor %}
{{- pairs(items) -}}
{%- endmacro %}
{%- macro instanceKeyMoments(instance, pauseInstance = 5) %}
{%- set locations = [] %}
{%- for change in instance.changes %}
  {%- set _ = locations.push(defaultAxes | merge(locations | last | merge(change.axes))) %}
{%- endfor %}
{%- for change in instance.changes %}
            {
              "label": "{{ instance.label }} {{ change.label }}",
              "duration": "1",
              "easing": "easeOutQuad",
              "axesLocations": {{ axesOf(locations[loop.index0]) }},
              "textColor": {{ color(white, "100.00000") }}
            },
            {
              "label": "pause",
              "duration": "1",
              "easing": "easeOutQuad",
              "axesLocations": {{ axesOf(locations[loop.index0]) }},
              "textColor": {{ color(white, "100.00000") }}
            },
{%- endfor %}
            {
              "label": "pause instance",
              "duration": "{{ pauseInstance }}",
              "easing": "easeOutQuad",
              "axesLocations": {{ axesOf(locations | last) }},
              "textColor": {{ color(white, "100.00000") }}
            },
{%- endmacro %}
{
