{#-
  One "H" that steps through the blend sources of Roboto Delta, one
  parametric axis at a time, and returns to the default between each
  source. The source values come from blends.json.
-#}
{%- set sample = "HO" %}
{%- set stageWidth = 1336 %}
{%- set textWidth = 1000 %}
{%- set position = [["x", (stageWidth - textWidth) / 2], ["y", 100], ["width", textWidth]] %}
{%- set white = [255, 255, 255] %}
{%- set black = [0, 0, 0] %}
{%- set defaultAxes = {"opsz": "14", "XOPQ": "96", "XTRA": "463", "YOPQ": "79", "YTUC": "728", "YTOS": "30", "XTSP": "0", "STUI": "92", "STUO": "92"} %}
{%- set defaultInstance = {
  "label": "default",
  "changes": [
    {"label": "all", "axes": defaultAxes }
  ]
} %}
{#-
