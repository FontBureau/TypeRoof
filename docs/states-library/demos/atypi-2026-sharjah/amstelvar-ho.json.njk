---json
{
  "permalink": "{{ page.filePathStem }}",
  "layout": null
}
---
{#-
  One "H" that steps through the blend sources of Amstelvar, one
  parametric axis at a time, and returns to the default between each
  source. The source values come from blends.json.
-#}
{%- set sample = "HO" %}
{%- set stageWidth = 1336 %}
{%- set textWidth = 1000 %}
{%- set position = [["x", (stageWidth - textWidth) / 2], ["y", 100], ["width", textWidth]] %}
{%- set white = [255, 255, 255] %}
{%- set black = [0, 0, 0] %}
{%- set yellow = [255, 255, 127] %}
{%- set defaultAxes = {"opsz": "14", "XOUC": "90", "XSHU": "104", "XTUC": "400", "XTUR": "561", "XUCS": "145", "XUCR": "40", "YOUC": "66", "YSHU": "50", "YTUC": "750", "YTOS": "11", "TN00": "0", "TN01": "0", "TN02": "0", "TN03": "0", "TN04": "0", "TN05": "0", "TN06": "0", "TN07": "0", "TN08": "0", "TN09": "0", "TN10": "0", "TN11": "0", "TN12": "0", "TN13": "0", "TN14": "0", "TN15": "0", "TN16": "0", "TN17": "0", "TN18": "0", "TN19": "0", "TN20": "0", "TN21": "0", "TN22": "0", "TN23": "0", "TN24": "0", "TN25": "0"} %}
{%- set defaultInstance = {
  "label": "default",
  "changes": [
    {"label": "all", "axes": defaultAxes }
  ]
} %}
{#-
