{#-
  Three rows of "HODnop01" at opsz 144, 14 and 8. The opsz 144 and 8
  rows are built from the parametric axes and step through them one at
  a time, see opsz144 and opsz8 below.
-#}
{%- set sample = "HODnop01" %}
{%- set stageWidth = 1336 %}
{%- set textWidth = 445 %}
{%- set fontSize = 32 %}
{%- set opsz144FontSize = 42 %}
{%- set opsz8FontSize = 24 %}
{%- set white = [255, 255, 255] %}
{#-
  Rows that step through the parametric axes, one settings block each.
  label, y      actor label and vertical position
  fontSize      optional, defaults to fontSize
  startDuration duration of the moment at startAxes
  changes       applied one after the other; every change is kept, so each
                location builds on the previous one
    label, duration, axes   the moment that animates to the changed axes
    pause                   duration of the "pause" moment that holds them
    isActive                marks that pause as the active key moment
  Every row shares startAxes, waitDuration, and fadeIn, see below.
-#}
{#- the axes location every row starts from; its key order is the order
    the axes are written in -#}
{%- set startAxes = {
  "opsz": "14",
  "XOPQ": "96",
  "XTRA": "463",
  "YOPQ": "79",
  "YTLC": "526",
  "YTUC": "728",
  "YTAS": "728",
  "YTDE": "-208",
  "YTFI": "743",
  "YTOS": "30",
  "XTSP": "0",
  "STUI": "92",
  "STUO": "92",
  "STLI": "32",
  "STLO": "32"
} %}
{#- settings shared by every row:
    waitDuration  time before the row starts changing
    fadeIn        duration of the fade in, at startAxes -#}
{%- set waitDuration = 1 %}
{%- set fadeIn = 3 %}
