<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{ title }} - Documentation - TypeRoof</title>
        <meta name="viewport" content="initial-scale=1,shrink-to-fit=no">
        <script>
          (function() {
            function updateRemToPt() {
              const html = document.documentElement;
              // Get the root font size in pixels
              const pxSize = parseFloat(getComputedStyle(html).fontSize);
              // Convert CSS pixels to CSS points (1px = 0.75pt)
              const ptSize = pxSize * 0.75;
              html.style.setProperty('--doc-font-size-pt', `${ptSize}`);
            }
            // Run immediately on parse
            updateRemToPt();
            // Re-evaluate when the user zooms (browser zoom triggers window resize)
            window.addEventListener('resize', updateRemToPt);
          })();
            function toggleMenu(evt) {
                evt && evt.preventDefault();
                for(const elem of document.querySelectorAll('.typeroof-ui_sidebar')){
                    // on load it is the first item
                    const [classA, classB] =  ['menu-hidden', 'menu-visible'],
                        actions = ['add', 'remove'];
                    if(elem.classList.contains(classA))
                        actions.reverse();
                    const [actionA, actionB] = actions;
                    elem.classList[actionA](classA);
                    elem.classList[actionB](classB);
                }
            }
            addEventListener("DOMContentLoaded", (event) => {
                for(const elem of document.querySelectorAll('.typeroof-ui_sidebar .toggle-menu'))
                    elem.addEventListener('click', toggleMenu);
                toggleMenu();
            });
        </script>
        <link rel="stylesheet" href="{{rootPath}}lib/css/shell/docs.css">
        <!-- for syntax highlighting https://www.11ty.dev/docs/plugins/syntaxhighlight/-->
        <link
            href="https://unpkg.com/prismjs@1.29.0/themes/prism-tomorrow.min.css"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=add,arrow_forward,chevron_right,delete,download,drag_pan,edit_square,format_align_center,format_align_left,format_align_right,keyboard_arrow_down,keyboard_arrow_up,keyboard_double_arrow_left,keyboard_double_arrow_right,pause,place_item,play_arrow,play_circle,refresh,remove,swap_vert" />
    </head>
    <body class="typeroof-docs">
        <div class="wrapper">
            <div class="typeroof-ui_sidebar">
                <header><h1><span class="typeroof">TypêRoof</span> Documentation</h1></header>
                <button class="toggle-menu">Menu</button>
                <nav>
                    {{ collections.all
                        | eleventyNavigation
                        | collapseNavBranch(eleventyNavigation.key)
                        | eleventyNavigationToHtml({
                            activeListItemClass: "active",
                            activeKey: eleventyNavigation.key
                        })
                        | safe
                    }}
                    <h3>Applications</h3>
                    <ul class="typeroof-ui_sidebar-app_links">
                        <li><a href="{{rootPath}}/shell">TypeRoof Shell</a></li>
                        <li><a href="{{rootPath}}/legacy">TypeRoof Legacy</a></li>
                        <li><a href="{{rootPath}}/app/wikipedia">Wikipedia Demo</a></li>
                    </ul>
                    <h3>Support</h3>
                    <ul>
                        <li><a href="https://typeroof.org/">TypeRoof Landing Page</a></li>
                        <li><a href="https://forum.typeroof.org/">Community Forum</a></li>
                        <li><a href="https://github.com/FontBureau/TypeRoof">GitHub</a></li>
                        <li><a href="https://github.com/FontBureau/TypeRoof/issues">Issues</a></li>
                    </ul>
                </nav>
                <button class="toggle-menu toggle-menu-bottom">Menu</button>
            </div>
            <div class="typeroof-main">
                <article class='typeroof-docs_content'>{% if agentCreated %}<p class="agent-created-note">** This file was created with an agent. **</p>{% endif %}{{ content | safe }}</article>
            </div>
        </div> <!-- wrapper -->
    </body>
</html>
