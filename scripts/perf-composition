#!/usr/bin/env node
/**
 * perf:composition — text-composition performance baseline
 * (Sprint B, docs/planning/text-composition/ROADMAP.md).
 *
 * Measures update-cycle cost with textComposition ON vs OFF against
 * the wikipedia-scale fixture (a TypeStage state in
 * docs/states-library/fixtures/), in two profiles:
 *   - typing bursts (incremental recomposition: edit a text node)
 *   - full recompose (style-change burst: touch a typeSpec property
 *     that recomposes everything)
 *
 * Key metric: the overhead RATIO (t_on / t_off) — machine-stable,
 * unlike absolute ms.
 *
 * Regression detection: a checked-in snapshot (perf-composition.baseline.json
 * next to this script) updated DELIBERATELY (--write-baseline) so the
 * commit documents legitimate cost changes; deviations beyond
 * REGRESSION_FACTOR exit non-zero.
 *
 * Usage:
 *   scripts/perf-composition [--player-url=URL] [--cycles=N]
 *                            [--write-baseline]
 * Requires the Vite dev server (port 3000). The script stages the
 * checked-in wikipedia fixture under downloads/ for Vite serving and
 * removes it on exit.
 */
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
    readFileSync,
    writeFileSync,
    existsSync,
    copyFileSync,
    mkdirSync,
    rmSync,
} from "node:fs";
import { execSync } from "node:child_process";
import puppeteer from "puppeteer";
import { ArgumentParser } from "argparse";
import { setTimeout } from "node:timers/promises";

const __dirname = path.dirname(fileURLToPath(import.meta.url)),
    BASELINE_PATH = path.join(__dirname, "perf-composition.baseline.json"),
    SOURCE_FIXTURE_PATH = path.join(
        __dirname,
        "../docs/states-library/fixtures/wikipedia-snapshot.json",
    ),
    STAGED_FIXTURE_PATH = path.join(
        __dirname,
        "../downloads/perf-wikipedia-snapshot.tmp.json",
    ),
    // Vite serves /downloads directly; the docs path requires the
    // separate Eleventy server and silently falls back to HTML when
    // unavailable. scripts/perf-composition stages the checked-in
    // wikipedia fixture here before launch (see main()).
    FIXTURE_URL = "/TypeRoof/downloads/perf-wikipedia-snapshot.tmp.json",
    REGRESSION_FACTOR = 1.5,
    DEFAULT_CYCLES = 30;

const parser = new ArgumentParser();
parser.add_argument("--player-url", {
    // The generic player accepts the complete ApplicationModel state.
    default: "http://localhost:3000/TypeRoof/app/player",
});
parser.add_argument("--cycles", { type: "int", default: DEFAULT_CYCLES });
parser.add_argument("--write-baseline", { action: "store_true" });
const args = parser.parse_args();

async function waitForShell(page) {
    for (let count = 0; count * 500 <= 60000; count++) {
        if (await page.evaluate(() => "shell" in window)) return;
        await setTimeout(500);
    }
    throw new Error("TIMEOUT waiting for shell");
}

// One measured burst, driven inside the page. mode: "typing" | "recompose"
async function measureBurst(page, compositionOn, mode, cycles) {
    return page.evaluate(
        async ({ compositionOn, mode, cycles }) => {
            const rootPath = "/activeState",
                // engagement IS the algorithm selection: ON = the
                // milestone-4 Greedy Fit algorithm (Treatment Planner
                // active), OFF = "None (Browser)" (the opt-out type)
                setComposition = (on) =>
                    shell.changeState(() => {
                        shell.getEntry(
                            `${rootPath}/typeSpec/textCompositionAlgorithm/textCompositionAlgorithmTypeKey`,
                        ).value = on
                            ? "TextCompositionAlgorithmGreedyFitModel"
                            : "TextCompositionAlgorithmNoneModel";
                    });
            await setComposition(compositionOn);

            // find the first text node path (immutable walk)
            const doc = shell.getEntry(`${rootPath}/document`),
                findFirstTextPath = (node, path) => {
                    for (const [index, child] of node
                        .get("content")
                        .value.entries()) {
                        const childPath = `${path}/content/${index}`;
                        if (child.get("typeKey").value === "text")
                            return childPath;
                        const found = findFirstTextPath(child, childPath);
                        if (found !== null) return found;
                    }
                    return null;
                },
                textPath = findFirstTextPath(doc, `${rootPath}/document`);

            const t0 = performance.now();
            for (let i = 0; i < cycles; i++) {
                await shell.changeState(() => {
                    if (mode === "typing") {
                        const text = shell.getEntry(`${textPath}/text`);
                        text.value = `perf probe ${i} ${"x".repeat(i % 40)}`;
                    } else {
                        // full recompose: a composition-relevant style
                        // change (relativeFontSize wiggle)
                        const rel = shell.getEntry(
                            `${rootPath}/typeSpec/relativeFontSize`,
                        );
                        rel.value = 1 + (i % 2) * 0.0001;
                    }
                });
            }
            const t1 = performance.now();
            await setComposition(true);
            return t1 - t0;
        },
        { compositionOn, mode, cycles },
    );
}

async function main() {
    mkdirSync(path.dirname(STAGED_FIXTURE_PATH), { recursive: true });
    copyFileSync(SOURCE_FIXTURE_PATH, STAGED_FIXTURE_PATH);
    const url = new URL(
            `#[no-chrome]from-url:${FIXTURE_URL}`,
            args.player_url,
        ),
        browser = await puppeteer.launch({
            headless: true,
            timeout: 100000,
            executablePath: "/usr/bin/chromium-browser",
        });
    console.log(`Source: ${url}`);
    const results = {};
    try {
        const page = await browser.newPage();
        await page.setViewport({ width: 1920, height: 1080 });
        await page.goto(url.toString(), {
            waitUntil: ["load", "domcontentloaded"],
        });
        await waitForShell(page);
        // settle
        await setTimeout(1000);
        // Fail loud instead of benchmarking an HTML fallback / tiny
        // default document (the historical docs URL could 404 while
        // page.goto still succeeded).
        const fixtureInfo = await page.evaluate(() => {
            const countText = (node) => {
                    let count = 0;
                    if (node.get("typeKey").value === "text") count++;
                    const content = node.get("content", null);
                    if (content !== null)
                        for (const child of content.value)
                            count += countText(child);
                    return count;
                },
                rootPath = "/activeState",
                doc = shell.getEntry(`${rootPath}/document`);
            return {
                textNodes: countText(doc),
                activeLayoutKey: shell.getEntry("/activeLayoutKey").value,
            };
        });
        if (fixtureInfo.textNodes < 100)
            throw new Error(
                `FIXTURE ERROR expected wikipedia-scale state, got ` +
                    `${fixtureInfo.textNodes} text nodes ` +
                    `(layout ${fixtureInfo.activeLayoutKey}).`,
            );
        console.log(
            `Fixture verified: ${fixtureInfo.textNodes} text nodes, ` +
                `layout ${fixtureInfo.activeLayoutKey}`,
        );

        for (const mode of ["typing", "recompose"]) {
            const off = await measureBurst(page, false, mode, args.cycles),
                on = await measureBurst(page, true, mode, args.cycles);
            results[mode] = {
                offMs: Math.round(off * 100) / 100,
                onMs: Math.round(on * 100) / 100,
                ratio: Math.round((on / off) * 1000) / 1000,
            };
            console.log(
                `${mode}: OFF ${results[mode].offMs}ms, ON ${results[mode].onMs}ms, ` +
                    `overhead ratio ${results[mode].ratio}`,
            );
        }
    } finally {
        await browser.close();
    }

    let gitCommit = "unknown";
    try {
        gitCommit = execSync("git rev-parse --short HEAD").toString().trim();
    } catch {
        /* not in a git repo */
    }

    if (args.write_baseline) {
        const baseline = {
                gitCommit,
                date: new Date().toISOString(),
                cycles: args.cycles,
                metrics: results,
            };
        writeFileSync(BASELINE_PATH, JSON.stringify(baseline, null, 2) + "\n");
        console.log(`Baseline written: ${BASELINE_PATH}`);
        return;
    }

    if (!existsSync(BASELINE_PATH)) {
        console.warn(
            `No baseline at ${BASELINE_PATH} — run with --write-baseline to create one.`,
        );
        return;
    }
    const baseline = JSON.parse(readFileSync(BASELINE_PATH, "utf8"));
    console.log(
        `Baseline: ${baseline.gitCommit} (${baseline.date}, ${baseline.cycles} cycles)`,
    );
    let regressions = 0;
    for (const mode of Object.keys(results)) {
        const current = results[mode],
            base = baseline.metrics[mode];
        if (!base) continue;
        for (const key of ["onMs", "ratio"]) {
            const deviation = current[key] / base[key];
            if (deviation > REGRESSION_FACTOR) {
                regressions++;
                console.error(
                    `REGRESSION ${mode}.${key}: ${current[key]} vs baseline ${base[key]} ` +
                        `(${deviation.toFixed(2)}x > ${REGRESSION_FACTOR}x)`,
                );
            } else
                console.log(
                    `ok ${mode}.${key}: ${current[key]} vs baseline ${base[key]} ` +
                        `(${deviation.toFixed(2)}x)`,
                );
        }
    }
    if (regressions > 0) {
        console.error(`${regressions} regression(s) detected.`);
        process.exitCode = 1;
        return;
    }
    console.log("No regressions.");
}

main()
    .catch((error) => {
        console.error(error);
        process.exitCode = 2;
    })
    .finally(() => {
        rmSync(STAGED_FIXTURE_PATH, { force: true });
    });
