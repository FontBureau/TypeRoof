#!/usr/bin/env node
/**
 * Text-composition performance investigation harness.
 *
 * quick: semantic smoke run over representative arms; intended for routine use.
 * full: exhaustive steady matrix (5 warmups + 30 edits), with cold and
 * transition operations sampled five times separately. Explicitly heavy.
 * profile: representative cold load and warm edit CDP CPU profiles.
 *
 * Generated JSON and *.cpuprofile files live under
 * artifacts/perf-composition/ and are intentionally ignored.
 */
import path from "node:path";
import { ArgumentParser } from "argparse";
import {
    ALGORITHMS,
    DEFAULT_PLAYER_URL,
    RENDERER_MODES,
    SOURCE_FIXTURE_PATH,
    VIEWPORT,
    closeAllBrowsers,
    fixtureURL,
    installPublicationObserver,
    launchBrowser,
    openFixturePage,
    prepareInteractionPaths,
    removeStagedFixtures,
    runOperation,
    stageFixtures,
    verifyFixture,
    waitForShell,
} from "./perf-composition-page.mjs";
import {
    aggregateRatios,
    coldMatrix,
    gitCommit,
    scenarioKey,
    scenarioMatrix,
    summarize,
    transitionMatrix,
    summarizeCold,
    summarizeCPUProfile,
    validateResult,
    writeJSON,
} from "./perf-composition-lib.mjs";

const parser = new ArgumentParser({ description: "Profile TypeRoof text composition" });
parser.add_argument("--suite", { choices: ["quick", "full", "profile"], default: "quick" });
parser.add_argument("--player-url", { default: DEFAULT_PLAYER_URL });
parser.add_argument("--output", { default: null });
parser.add_argument("--cold-samples", { type: "int", default: null });
parser.add_argument("--warmups", { type: "int", default: null });
parser.add_argument("--samples", { type: "int", default: null });
const args = parser.parse_args(),
    defaults =
        args.suite === "full"
            ? {
                  coldSamples: 5,
                  warmups: 5,
                  steadySamples: 30,
                  transitionSamples: 5,
              }
            : {
                  coldSamples: 1,
                  warmups: 1,
                  steadySamples: 3,
                  transitionSamples: 1,
              },
    sampling = {
        coldSamples: args.cold_samples ?? defaults.coldSamples,
        warmups: args.warmups ?? defaults.warmups,
        steadySamples: args.samples ?? defaults.steadySamples,
        transitionSamples: defaults.transitionSamples,
    },
    timestamp = new Date().toISOString().replaceAll(":", "-").replace(".", "-"),
    artifactDirectory = path.resolve("artifacts/perf-composition", timestamp),
    outputPath = path.resolve(args.output ?? path.join(artifactDirectory, "result.json"));

const round = (value) => Math.round(value * 1000) / 1000,
    resultBase = (browserVersion) => ({
        schemaVersion: 1,
        suite: args.suite,
        generatedAt: new Date().toISOString(),
        gitCommit: gitCommit(),
        browser: browserVersion,
        sourceFixture: path.relative(process.cwd(), SOURCE_FIXTURE_PATH),
        viewport: VIEWPORT,
        sampling,
    });

async function measureCold(browser) {
    const results = [];
    for (let repetition = 0; repetition < sampling.coldSamples; repetition++) {
        const matrix = coldMatrix(args.suite),
            arms = repetition % 2 === 0 ? matrix : [...matrix].reverse();
        for (const arm of arms) {
            const opened = await openFixturePage(
                browser,
                args.player_url,
                arm.rendererMode,
                arm.algorithm,
            );
            try {
                results.push({
                    kind: "cold",
                    ...arm,
                    repetition,
                    shellReadyMs: round(opened.shellReadyMs),
                    publications: opened.publications,
                    fixture: opened.fixture,
                });
            } finally {
                await opened.page.close();
            }
        }
    }
    return results;
}

async function measureSteady() {
    const results = [], scenarios = scenarioMatrix(args.suite);
    for (const scenario of scenarios) {
        const browser = await launchBrowser(),
            opened = await openFixturePage(
                browser,
                args.player_url,
                scenario.rendererMode,
                scenario.algorithm,
            );
        try {
            const paths = await prepareInteractionPaths(opened.page), samples = [];
            for (let index = 0; index < sampling.warmups; index++)
                await runOperation(opened.page, scenario, index, paths);
            for (let index = 0; index < sampling.steadySamples; index++)
                samples.push(
                    await runOperation(
                        opened.page,
                        scenario,
                        sampling.warmups + index,
                        paths,
                    ),
                );
            const durations = samples.map(({ durationMs }) => round(durationMs));
            results.push({
                kind: "steady",
                ...scenario,
                warmups: sampling.warmups,
                samples: samples.map((sample, index) => ({
                    durationMs: durations[index],
                    publications: sample.publications,
                })),
                summary: summarize(durations),
                fixture: opened.fixture,
            });
            console.log(scenarioKey(scenario), round(results.at(-1).summary.medianMs), "ms median");
        } finally {
            await opened.page.close().catch(() => {});
            await browser.close().catch(() => {});
        }
    }
    return results;
}

async function measureTransitions() {
    const results = [];
    for (const scenario of transitionMatrix(args.suite)) {
        const browser = await launchBrowser(),
            opened = await openFixturePage(
                browser,
                args.player_url,
                scenario.rendererMode,
                scenario.algorithm,
            );
        const samples = [];
        try {
            const paths = await prepareInteractionPaths(opened.page);
            for (let index = 0; index < sampling.transitionSamples; index++)
                samples.push(
                    await runOperation(opened.page, scenario, index, paths),
                );
        } finally {
            await opened.page.close().catch(() => {});
            await browser.close().catch(() => {});
        }
        const durations = samples.map(({ durationMs }) => round(durationMs));
        results.push({
            kind: "transition",
            ...scenario,
            samples: samples.map((sample, index) => ({
                durationMs: durations[index],
                publications: sample.publications,
            })),
            summary: summarize(durations),
        });
        console.log(
            scenarioKey(scenario),
            round(results.at(-1).summary.medianMs),
            "ms transition median",
        );
    }
    return results;
}

async function captureProfile(browser, kind, scenario, outputName) {
    const page = await browser.newPage();
    await page.setViewport(VIEWPORT);
    const session = await page.createCDPSession();
    await session.send("Profiler.enable");
    let fixture;
    try {
        if (kind === "cold") {
            await installPublicationObserver(page);
            await session.send("Profiler.start");
            await page.goto(
                fixtureURL(
                    args.player_url,
                    scenario.rendererMode,
                    scenario.algorithm,
                ).toString(),
                {
                    waitUntil: ["load", "domcontentloaded"],
                    timeout: 180000,
                },
            );
            await waitForShell(page);
            fixture = await verifyFixture(
                page,
                scenario.rendererMode,
                scenario.algorithm,
            );
        } else {
            const opened = await openFixturePage(
                browser,
                args.player_url,
                scenario.rendererMode,
                scenario.algorithm,
            );
            fixture = opened.fixture;
            const paths = await prepareInteractionPaths(opened.page),
                operationSession = await opened.page.createCDPSession();
            await operationSession.send("Profiler.enable");
            await operationSession.send("Profiler.start");
            await runOperation(opened.page, scenario, 1000, paths);
            const { profile } = await operationSession.send("Profiler.stop");
            await operationSession.send("Profiler.disable");
            const profilePath = path.join(artifactDirectory, outputName);
            writeJSON(profilePath, profile);
            await opened.page.close();
            return { kind, ...scenario, fixture, outputPath: profilePath, dominantStacks: summarizeCPUProfile(profile) };
        }
        const { profile } = await session.send("Profiler.stop");
        const profilePath = path.join(artifactDirectory, outputName);
        writeJSON(profilePath, profile);
        return { kind, ...scenario, fixture, outputPath: profilePath, dominantStacks: summarizeCPUProfile(profile) };
    } finally {
        await session.send("Profiler.disable").catch(() => {});
        await page.close();
    }
}

let stopping = false;
const stop = async (signal) => {
    if (stopping) return;
    stopping = true;
    console.error(`Received ${signal}; closing benchmark browsers.`);
    await closeAllBrowsers();
    removeStagedFixtures();
    process.exit(signal === "SIGINT" ? 130 : 143);
};
process.once("SIGINT", () => void stop("SIGINT"));
process.once("SIGTERM", () => void stop("SIGTERM"));

async function main() {
    stageFixtures();
    let browser = await launchBrowser();
    try {
        const browserVersion = await browser.version();
        let result;
        if (args.suite === "profile") {
            const profiles = [
                await captureProfile(
                    browser,
                    "cold",
                    { rendererMode: "editor", algorithm: "fit", workload: "initial-load" },
                    "cold-editor-fit.cpuprofile",
                ),
                await captureProfile(
                    browser,
                    "warm",
                    {
                        rendererMode: "viewer",
                        algorithm: "fit",
                        workload: "inherited-style-partial-recompose",
                    },
                    "warm-viewer-fit-recompose.cpuprofile",
                ),
            ];
            result = { ...resultBase(browserVersion), profiles };
        } else {
            const cold = await measureCold(browser);
            await browser.close();
            browser = null;
            const steady = await measureSteady(),
                transitions = await measureTransitions();
            result = {
                ...resultBase(browserVersion),
                cold,
                coldSummary: summarizeCold(cold),
                steady,
                transitions,
                aggregateRatios: aggregateRatios(steady),
            };
        }
        validateResult(result);
        writeJSON(outputPath, result);
        console.log(`Validated ${args.suite} result: ${outputPath}`);
    } finally {
        if (browser !== null) await browser.close();
        removeStagedFixtures();
    }
}

main().catch((error) => {
    console.error(error);
    removeStagedFixtures();
    process.exitCode = 2;
});
